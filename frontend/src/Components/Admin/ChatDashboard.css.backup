.chat-dashboard {
  padding: 16px;
  min-height: 100vh;
  background: #f5f6fa;
}

@media (min-width: 768px) {
  .chat-dashboard {
    padding: 20px;
  }
}

.chat-stats {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.stat-card {
  background: white;
  padding: 16px;
  border-radius: 10px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  flex: 1;
  min-width: 120px;
  text-align: center;
  transition: transform 0.2s, box-shadow 0.2s;
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
}

.stat-card h3 {
  margin: 0 0 6px 0;
  font-size: 28px;
  color: #667eea;
  font-weight: 700;
}

.stat-card p {
  margin: 0;
  color: #666;
  font-size: 13px;
  font-weight: 500;
}

.chat-container {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  height: calc(100vh - 200px);
  min-height: 500px;
}

@media (min-width: 1024px) {
  .chat-container {
    grid-template-columns: 320px 1fr;
  }
}

.chat-list {
  background: white;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-list-header {
  padding: 16px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-bottom: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.chat-list-header h2 {
  margin: 0;
  font-size: 18px;
  color: white;
  font-weight: 600;
}

.chat-list-header select {
  padding: 6px 10px;
  border: 1px solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.2);
  color: white;
  border-radius: 6px;
  font-size: 13px;
  cursor: pointer;
  outline: none;
}

.chat-list-header select option {
  color: #333;
  background: white;
}

.chat-items {
  flex: 1;
  overflow-y: auto;
}

.chat-item {
  padding: 12px 16px;
  border-bottom: 1px solid #f0f0f0;
  cursor: pointer;
  transition: background 0.2s;
}

.chat-item:hover {
  background: #f8f9fa;
}

.chat-item.active {
  background: #f0f3ff;
  border-left: 3px solid #667eea;
}

.chat-item.unread {
  background: #fff8e1;
}

.chat-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.chat-item-header h4 {
  margin: 0;
  font-size: 14px;
  color: #333;
  font-weight: 600;
}

.chat-preview {
  font-size: 13px;
  color: #666;
  margin: 0 0 6px 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.chat-time {
  font-size: 11px;
  color: #999;
}

.unread-count {
  background: #ff4444;
  color: white;
  padding: 2px 6px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 600;
}

.status-badge {
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
}

.status-badge.open {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-badge.waiting {
  background: #fff3e0;
  color: #f57c00;
}

.status-badge.closed {
  background: #f5f5f5;
  color: #666;
}

.chat-preview {
  margin: 0 0 8px 0;
  font-size: 13px;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.chat-time {
  font-size: 12px;
  color: #999;
}

.unread-count {
  background: #667eea;
  color: white;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 600;
}

.chat-conversation {
  background: white;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.conversation-header {
  padding: 16px 20px;
  border-bottom: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.conversation-header h3 {
  margin: 0 0 3px 0;
  font-size: 16px;
  font-weight: 600;
}

.conversation-header p {
  margin: 0;
  font-size: 12px;
  opacity: 0.9;
}

.close-chat-btn {
  padding: 6px 16px;
  background: rgba(255,255,255,0.2);
  color: white;
  border: 1px solid rgba(255,255,255,0.3);
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.close-chat-btn:hover:not(:disabled) {
  background: rgba(255,255,255,0.3);
}

.close-chat-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.conversation-messages {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  background: #f8f9fa;
}

.message {
  margin-bottom: 20px;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message.user {
  text-align: left;
}

.message.admin {
  text-align: right;
}

.message-sender {
  font-size: 12px;
  color: #666;
  margin-bottom: 6px;
  font-weight: 600;
}

.message-text {
  display: inline-block;
  padding: 12px 18px;
  border-radius: 18px;
  max-width: 70%;
  word-wrap: break-word;
  line-height: 1.5;
}

.message.user .message-text {
  background: white;
  color: #333;
  border: 1px solid #e0e0e0;
}

.message.admin .message-text {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.message-time {
  font-size: 11px;
  color: #999;
  margin-top: 4px;
}

.typing-indicator {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 12px 18px;
  background: white;
  border-radius: 18px;
  border: 1px solid #e0e0e0;
}

.typing-indicator span {
  width: 8px;
  height: 8px;
  background: #999;
  border-radius: 50%;
  animation: typing 1.4s infinite;
}

.typing-indicator span:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-indicator span:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  30% {
    transform: translateY(-8px);
    opacity: 1;
  }
}

.conversation-input {
  display: flex;
  padding: 20px 24px;
  background: white;
  border-top: 1px solid #e0e0e0;
}

.conversation-input input {
  flex: 1;
  border: 1px solid #ddd;
  border-radius: 24px;
  padding: 12px 20px;
  font-size: 14px;
  outline: none;
  transition: border 0.2s;
}

.conversation-input input:focus {
  border-color: #667eea;
}

.conversation-input button {
  margin-left: 12px;
  padding: 12px 28px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 24px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.2s;
}

.conversation-input button:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.no-chat-selected {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #999;
}

.no-chat-selected svg {
  width: 80px;
  height: 80px;
  margin-bottom: 16px;
  opacity: 0.3;
}

.no-chat-selected p {
  font-size: 16px;
  margin: 0;
}

/* Scrollbar styling */
.chat-items::-webkit-scrollbar,
.conversation-messages::-webkit-scrollbar {
  width: 6px;
}

.chat-items::-webkit-scrollbar-track,
.conversation-messages::-webkit-scrollbar-track {
  background: transparent;
}

.chat-items::-webkit-scrollbar-thumb,
.conversation-messages::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 3px;
}

.chat-items::-webkit-scrollbar-thumb:hover,
.conversation-messages::-webkit-scrollbar-thumb:hover {
  background: #999;
}

@media (max-width: 1024px) {
  .chat-container {
    grid-template-columns: 1fr;
    height: auto;
  }

  .chat-list {
    max-height: 400px;
  }

  .chat-conversation {
    height: 600px;
  }
}

@media (max-width: 768px) {
  .chat-dashboard {
    padding: 15px;
  }

  .chat-stats {
    gap: 10px;
  }

  .stat-card {
    min-width: calc(50% - 5px);
  }

  .stat-card h3 {
    font-size: 28px;
  }
}
